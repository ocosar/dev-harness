{
  "version": 1,
  "language": "en",
  "timezone": "UTC",
  "paid": {
    "daily_cap_usd": 10,
    "bash_patterns": [
      "\\bcurl\\b[^\\n]*\\b(queue\\.)?fal\\.run\\b",
      "\\bcurl\\b[^\\n]*\\bapi\\.(openai|replicate|runwayml|lumalabs)\\.(com|ai)\\b"
    ],
    "mcp_tools": [
      "mcp__fal__(run_model|submit_job|submit_jobs)"
    ],
    "extra_ledgers": [],
    "secret_env": [],
    "request_max_age_h": 12
  },
  "protected_branches": [
    "main",
    "master"
  ],
  "merge": "owner",
  "check": {
    "command": "bash .harness/check.sh",
    "timeout_s": 600,
    "max_consecutive_blocks": 3
  },
  "unattended_env": "HARNESS_UNATTENDED",
  "locked_paths": [],
  "autoloop": {},
  "evals": {
    "second_opinion": {
      "mode": "manual",
      "required": false,
      "provider": "openai",
      "model": "",
      "key_env": "",
      "usd_per_mtok_in": 0,
      "usd_per_mtok_out": 0,
      "max_output_tokens": 2000,
      "max_diff_chars": 60000
    },
    "product": {
      "enabled": false,
      "cmd": "",
      "direction": "max",
      "tolerance": 0,
      "paid": false,
      "est_usd": 0,
      "judge": {
        "provider": "",
        "model": ""
      },
      "timeout_s": 3600
    }
  }
}
